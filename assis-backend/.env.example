# Dukkan backend settings. Copy this file to .env.local and fill in the key.
# Never share .env.local.

# API-only inference. No Codex subscription, local model or automatic fallback.
DIKAN_PROVIDER=openai

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
# Optional. Defaults to gpt-4.1-mini.
OPENAI_MODEL=gpt-4.1-mini
# Optional price caps (USD per million tokens). These are the gpt-4.1-mini rates.
# OPENAI_MAX_INPUT_USD_PER_M=0.40
# OPENAI_MAX_OUTPUT_USD_PER_M=1.60
# Optional daily USD reservation cap. Requests exceeding it are refused before sending.
# OPENAI_MAX_DAILY_USD=0.50

# Alternative: route inference through OpenRouter instead.
# Set DIKAN_PROVIDER=openrouter and configure its key and model below.
# This uses the same model pricing and adds OpenRouter account funding.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# OPENROUTER_ALLOW_PAID=true
# Price caps in US dollars per million tokens. Requests above these are refused.
# OPENROUTER_MAX_INPUT_USD_PER_M=1
# OPENROUTER_MAX_OUTPUT_USD_PER_M=3

# Other options for DIKAN_PROVIDER:
#   openrouter          API model only, no fallback
#   siliconflow         API model only; configure its region, model and key
#   none                no AI; records, documents and dashboards still work

DIKAN_MAX_OUTPUT_TOKENS=4096
DIKAN_MAX_INPUT_BYTES=60000
DIKAN_MAX_REQUESTS_PER_DAY=100
# Optional visible PDF progress pacing, 0–2000 ms per actual field update.
# DIKAN_PDF_PROGRESS_INTERVAL_MS=1600
ASSIS_PRIVATE_ROOT=.private-chat-demo
ASSIS_PORT=8789
